# 测试对 fixture 做含 \n 的字面量替换，行尾漂移会让替换静默失效。
# 按已知文本格式固定 LF，避免未来二进制 fixture 被文本转换。
crates/**/tests/fixtures/**/*.toml text eol=lf
crates/**/tests/fixtures/**/*.json text eol=lf
crates/**/tests/fixtures/**/*.jsonl text eol=lf
crates/**/tests/fixtures/**/*.txt text eol=lf
crates/**/tests/fixtures/**/*.py text eol=lf
